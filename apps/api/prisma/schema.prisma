generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id             String    @id @default(uuid()) @db.Uuid
  supabaseUserId String    @unique @map("supabase_user_id") @db.Uuid
  email          String    @unique @db.VarChar(255)
  displayName    String?   @map("display_name") @db.VarChar(150)
  avatarUrl      String?   @map("avatar_url") @db.Text
  authProvider   String    @default("google") @map("auth_provider") @db.VarChar(50)
  status         String    @default("active") @db.VarChar(30)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile              UserProfile?
  settings             UserSetting?
  weightLogs           WeightLog[]
  bmiLogs              BmiLog[]
  waterLogs            WaterLog[]
  sleepLogs            SleepLog[]
  workoutSessions      WorkoutSession[]
  mealLogs             MealLog[]
  checklistCompletions ChecklistCompletion[]
  checklistItems       ChecklistItem[]
  exerciseFavorites    ExerciseFavorite[]
  userWorkoutPrograms  UserWorkoutProgram[]
  userWorkoutHistory   UserWorkoutHistory[]
  userWorkoutStats     UserWorkoutStats?
  homeExerciseFavorites HomeExerciseFavorite[]

  @@map("app_users")
}


model UserProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  heightCm         Decimal?  @map("height_cm") @db.Decimal(5, 2)
  targetWeightKg   Decimal?  @map("target_weight_kg") @db.Decimal(5, 2)
  timezone         String    @default("UTC") @db.VarChar(80)
  profileCompleted Boolean   @default(false) @map("profile_completed")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSetting {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  dailyWaterGoalMl      Int       @default(2500) @map("daily_water_goal_ml")
  dailyCalorieGoal      Int?      @map("daily_calorie_goal")
  dailySleepGoalMinutes Int       @default(480) @map("daily_sleep_goal_minutes")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model WeightLog {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  weightKg          Decimal  @map("weight_kg") @db.Decimal(5, 2)
  bodyFatPercentage Decimal? @map("body_fat_percentage") @db.Decimal(5, 2)
  muscleMassKg      Decimal? @map("muscle_mass_kg") @db.Decimal(5, 2)
  loggedAt          DateTime @map("logged_at") @db.Timestamptz(6)
  logDate  DateTime @map("log_date") @db.Date
  notes    String?  @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, logDate])
  @@index([userId, loggedAt])
  @@map("weight_logs")
}

model BmiLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  bmiValue    Decimal  @map("bmi_value") @db.Decimal(5, 2)
  bmiCategory String   @map("bmi_category") @db.VarChar(50)
  loggedAt    DateTime @map("logged_at") @db.Timestamptz(6)
  logDate     DateTime @map("log_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, logDate])
  @@map("bmi_logs")
}

model WaterLog {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  amountMl Int      @map("amount_ml")
  loggedAt DateTime @map("logged_at") @db.Timestamptz(6)
  logDate  DateTime @map("log_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, logDate])
  @@map("water_logs")
}

model SleepLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  durationMinutes Int      @map("duration_minutes")
  qualityRating   Int?     @map("quality_rating") @db.SmallInt
  logDate         DateTime @map("log_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, logDate])
  @@map("sleep_logs")
}

model WorkoutSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  userWorkoutProgramId String?   @map("user_workout_program_id") @db.Uuid
  programDayId         String?   @map("program_day_id") @db.Uuid
  startTime            DateTime  @map("start_time") @db.Timestamptz(6)
  endTime              DateTime? @map("end_time") @db.Timestamptz(6)
  durationMinutes      Int?      @map("duration_minutes")
  caloriesBurned       Int?      @map("calories_burned")
  notes                String?   @db.Text
  logDate              DateTime  @map("log_date") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  user               AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWorkoutProgram UserWorkoutProgram? @relation(fields: [userWorkoutProgramId], references: [id], onDelete: SetNull)
  exercises          WorkoutExercise[]

  @@index([userId, logDate])
  @@index([userWorkoutProgramId])
  @@map("workout_sessions")
}

model WorkoutExercise {
  id               String   @id @default(uuid()) @db.Uuid
  workoutSessionId String   @map("workout_session_id") @db.Uuid
  exerciseId       String   @map("exercise_id") @db.Uuid
  order            Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets           WorkoutSet[]

  @@index([workoutSessionId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String   @id @default(uuid()) @db.Uuid
  workoutExerciseId String   @map("workout_exercise_id") @db.Uuid
  setNumber         Int      @map("set_number")
  reps              Int?
  weight            Decimal? @db.Decimal(5, 2)
  duration          Int?
  restTime          Int?     @map("rest_time")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
  @@map("workout_sets")
}

model MealLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  mealType  String      @map("meal_type") @db.VarChar(50)
  logDate   DateTime    @map("log_date") @db.Date
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(6)

  user    AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MealEntry[]

  @@index([userId, logDate])
  @@map("meal_logs")
}

model MealEntry {
  id        String  @id @default(uuid()) @db.Uuid
  mealLogId String  @map("meal_log_id") @db.Uuid
  calories  Decimal @default(0) @db.Decimal(8, 2)
  proteinG  Decimal @default(0) @map("protein_g") @db.Decimal(8, 2)
  carbsG    Decimal @default(0) @map("carbs_g") @db.Decimal(8, 2)
  fatG      Decimal @default(0) @map("fat_g") @db.Decimal(8, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  @@index([mealLogId])
  @@map("meal_entries")
}
enum ChecklistItemCategory {
  WATER
  SLEEP
  WEIGHT
  WORKOUT
  NUTRITION
  CUSTOM
}

enum ChecklistSystemKey {
  WATER_GOAL
  SLEEP_LOG
  WEIGHT_LOG
  WORKOUT_SESSION
  NUTRITION_LOG
}

model ChecklistItem {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  title     String                @db.VarChar(255)
  category  ChecklistItemCategory @default(CUSTOM)
  systemKey ChecklistSystemKey?   @map("system_key")
  sortOrder Int                   @default(0) @map("sort_order")
  isActive  Boolean               @default(true) @map("is_active")
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        AppUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions ChecklistCompletion[]

  @@unique([userId, systemKey], name: "user_system_key_unique")
  @@index([userId, sortOrder])
  @@map("checklist_items")
}

model ChecklistCompletion {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  checklistItemId String   @map("checklist_item_id") @db.Uuid
  completionDate  DateTime @map("completion_date") @db.Date
  isCompleted     Boolean  @default(false) @map("is_completed")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistItemId, completionDate], name: "user_item_date_unique")
  @@index([userId, completionDate])
  @@map("checklist_completions")
}

enum ExerciseCategory {
  CARDIO
  STRENGTH
  FLEXIBILITY
  BALANCE
  PLYOMETRICS
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Exercise {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  description      String
  category         ExerciseCategory
  difficulty       Difficulty
  equipment        String[]         @default([])
  targetMuscles    String[]         @default([]) @map("target_muscles")
  secondaryMuscles String[]         @default([]) @map("secondary_muscles")
  mets             Float?
  instructions     String           @db.Text
  tips             String?          @db.Text
  imageUrl         String?          @map("image_url")
  videoUrl         String?          @map("video_url")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  favorites        ExerciseFavorite[]
  workoutExercises WorkoutExercise[]
  programExercises WorkoutProgramExercise[]

  @@map("exercises")
}

model ExerciseFavorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@map("exercise_favorites")
}

enum ProgramGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
}

model WorkoutProgram {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String
  difficulty  Difficulty
  goal        ProgramGoal
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  weeks        WorkoutProgramWeek[]
  userPrograms UserWorkoutProgram[]

  @@map("workout_programs")
}

model WorkoutProgramWeek {
  id         String   @id @default(uuid()) @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  weekNumber Int      @map("week_number")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  program WorkoutProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  days    WorkoutProgramDay[]

  @@map("workout_program_weeks")
}

model WorkoutProgramDay {
  id         String   @id @default(uuid()) @db.Uuid
  weekId     String   @map("week_id") @db.Uuid
  dayNumber  Int      @map("day_number")
  title      String?
  isRestDay  Boolean  @default(false) @map("is_rest_day")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  week      WorkoutProgramWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises WorkoutProgramExercise[]

  @@map("workout_program_days")
}

model WorkoutProgramExercise {
  id         String   @id @default(uuid()) @db.Uuid
  dayId      String   @map("day_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  order      Int
  sets       Int
  reps       Int?
  restTime   Int?     @map("rest_time")
  
  day      WorkoutProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("workout_program_exercises")
}

model UserWorkoutProgram {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  currentWeek Int      @default(1) @map("current_week")
  currentDay  Int      @default(1) @map("current_day")
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         WorkoutProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  workoutSessions WorkoutSession[]

  @@map("user_workout_programs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 7.1 — Guided Home Workout System
// ─────────────────────────────────────────────────────────────────────────────

model MuscleGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exercises HomeExerciseMuscleGroup[]

  @@map("muscle_groups")
}

model HomeExercise {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  description      String   @db.Text
  instructions     String   @db.Text
  difficulty       Difficulty
  bodyPart         String   @map("body_part") @db.VarChar(100)
  equipment        String   @default("none") @db.VarChar(100)
  caloriesPerMinute Float   @default(5.0) @map("calories_per_minute")
  defaultDuration  Int?     @map("default_duration")  // seconds
  defaultReps      Int?     @map("default_reps")
  restTime         Int?     @map("rest_time")          // seconds
  homeFriendly     Boolean  @default(true) @map("home_friendly")
  thumbnailUrl     String?  @map("thumbnail_url") @db.Text
  gifUrl           String?  @map("gif_url") @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  muscleGroups     HomeExerciseMuscleGroup[]
  programExercises HomeWorkoutProgramExercise[]
  favorites        HomeExerciseFavorite[]

  @@index([slug])
  @@index([difficulty])
  @@index([bodyPart])
  @@map("home_exercises")
}

model HomeExerciseMuscleGroup {
  exerciseId    String @map("exercise_id") @db.Uuid
  muscleGroupId String @map("muscle_group_id") @db.Uuid

  exercise    HomeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup  @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@map("home_exercise_muscle_groups")
}

enum HomeWorkoutGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  FLEXIBILITY
}

model HomeWorkoutProgram {
  id                String          @id @default(uuid()) @db.Uuid
  title             String          @db.VarChar(255)
  description       String          @db.Text
  goal              HomeWorkoutGoal
  difficulty        Difficulty
  estimatedMinutes  Int             @map("estimated_minutes")
  estimatedCalories Int             @map("estimated_calories")
  thumbnail         String?         @db.Text
  isFeatured        Boolean         @default(false) @map("is_featured")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercises HomeWorkoutProgramExercise[]
  history   UserWorkoutHistory[]

  @@index([goal])
  @@index([difficulty])
  @@index([isFeatured])
  @@map("home_workout_programs")
}

model HomeWorkoutProgramExercise {
  id         String   @id @default(uuid()) @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  order      Int
  duration   Int?     // seconds; null means rep-based
  reps       Int?
  rest       Int?     @default(30) // seconds between sets

  program  HomeWorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercise HomeExercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([programId, order])
  @@map("home_workout_program_exercises")
}

enum HomeWorkoutStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model UserWorkoutHistory {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  programId   String?           @map("program_id") @db.Uuid
  duration    Int               // seconds
  calories    Int
  completedAt DateTime          @map("completed_at") @db.Timestamptz(6)
  status      HomeWorkoutStatus @default(COMPLETED)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user    AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program HomeWorkoutProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt])
  @@index([userId, status])
  @@map("user_workout_history")
}

model UserWorkoutStats {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  totalWorkouts  Int       @default(0) @map("total_workouts")
  totalMinutes   Int       @default(0) @map("total_minutes")
  totalCalories  Int       @default(0) @map("total_calories")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastWorkoutDate DateTime? @map("last_workout_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_workout_stats")
}

model HomeExerciseFavorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise HomeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@map("home_exercise_favorites")
}
